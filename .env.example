# ─────────────────────────────────────────────────────────────
# Tabular — environment variables (copy to .env.local where used)
# ─────────────────────────────────────────────────────────────

# Web app (apps/tabular) -------------------------------------------------
# URL of the FastAPI extraction engine. Kept server-side; never exposed to client.
ENGINE_URL=http://localhost:8000

# Free-tier limit (pages) before paywall — config value, not hard-coded.
NEXT_PUBLIC_FREE_PAGE_LIMIT=5

# Auth (packages/auth) — SKELETON, not wired live in increment 1 -----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing (packages/billing) — SKELETON, not wired live in increment 1 -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics (packages/analytics) — SKELETON, no-op by default --------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Engine (services/engine) -------------------------------------------------
# Max pages accepted per upload.
ENGINE_MAX_PAGES=20
# Reconciliation tolerance in pence.
ENGINE_RECONCILE_TOLERANCE_PENCE=1
# Max rows accepted on the /export endpoint (abuse guard).
ENGINE_MAX_EXPORT_ROWS=10000
# CORS origins, comma-separated. "*" for local dev; set to the app origin(s) in
# production, e.g. https://app.tabular.example
ENGINE_ALLOWED_ORIGINS=*

# Shared secret so the engine rejects direct (non-app) callers. Set the SAME
# value here AND on the web app (Vercel) to enable it. Leave blank for local dev.
# Generate one with: openssl rand -hex 32
ENGINE_API_TOKEN=

# AI extraction for scanned/image-only PDFs (optional). When unset, scanned PDFs
# return a "please upload a text-based statement" message and CI runs unchanged.
# Uses Google Gemini; get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model override (default: gemini-2.5-flash).
LLM_MODEL=gemini-2.5-flash
